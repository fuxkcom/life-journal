# 说明：本文件是给「支持 _headers 的托管平台」用的（Cloudflare Pages / Netlify）。
# GitHub Pages 不支持自定义响应头，本文件在 GitHub Pages 上不会生效——
# 生产头请看 docs/cloudflare-setup.md（在 Cloudflare 侧用 Transform Rules 配置）。

# 带内容哈希的静态资源：一年强缓存 + immutable（更新时文件名会变，无需担心缓存旧文件）
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 其余所有响应：安全响应头
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.open-meteo.com https://ipwho.is https://ipapi.co https://api.bigdatacloud.net https://nominatim.openstreetmap.org https://api.vvhan.com https://api.rss2json.com https://api.allorigins.win https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
